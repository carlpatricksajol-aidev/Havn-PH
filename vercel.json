{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?r=sitemap"
    },
    {
      "source": "/room/:id",
      "destination": "/api/page?r=room&id=:id"
    },
    {
      "source": "/list",
      "destination": "/api/page?r=list"
    },
    {
      "source": "/rooms",
      "destination": "/api/page?r=rooms"
    },
    {
      "source": "/about",
      "destination": "/api/page?r=doc&d=about"
    },
    {
      "source": "/help",
      "destination": "/api/page?r=doc&d=help"
    },
    {
      "source": "/listing-standards",
      "destination": "/api/page?r=doc&d=listing-standards"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?r=doc&d=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/page?r=doc&d=terms"
    },
    {
      "source": "/contact",
      "destination": "/api/page?r=doc&d=contact"
    },
    {
      "source": "/signin",
      "destination": "/"
    },
    {
      "source": "/host",
      "destination": "/"
    },
    {
      "source": "/host/:path*",
      "destination": "/"
    },
    {
      "source": "/messages",
      "destination": "/"
    },
    {
      "source": "/messages/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/emails/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(signin|host|host/.*|messages|messages/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?havnph\\.com"
        }
      ],
      "destination": "https://www.ecstay.ph/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "{index.html,assets/js/data.js,assets/js/pages.js}",
      "maxDuration": 10
    }
  }
}
